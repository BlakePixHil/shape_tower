{
  "name": "shape-tower-game",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:game": "ST_APP=game vite build",
    "typecheck": "tsc -p .",
    "sim:smoke": "node --experimental-strip-types --no-warnings tests/sim-smoke.ts",
    "gesture:check": "node --experimental-transform-types --no-warnings tests/gesture-check.ts",
    "achievements:check": "node --experimental-strip-types --no-warnings tests/achievements-check.ts",
    "stores:check": "node --experimental-strip-types --no-warnings tests/stores-check.ts",
    "stores:ids": "node --experimental-strip-types --no-warnings scripts/stores-ids.ts",
    "stores:play": "node --experimental-strip-types --no-warnings scripts/play-achievements.ts",
    "stores:gamecenter": "node --experimental-strip-types --no-warnings scripts/gamecenter-achievements.ts",
    "testflight:team": "node --experimental-strip-types --no-warnings scripts/testflight-team.ts",
    "store-kit": "node --experimental-strip-types --no-warnings scripts/store-kit.ts",
    "daily:check": "node --experimental-strip-types --no-warnings tests/daily-logic.ts",
    "names:check": "node --experimental-strip-types --no-warnings tests/names-check.ts",
    "shop:check": "node --experimental-strip-types --no-warnings tests/shop-check.ts",
    "share:check": "node --experimental-strip-types --no-warnings tests/share-logic.ts",
    "ladder:check": "ST_APP=game vite build && node tests/ladder-check.mjs",
    "postinstall": "node scripts/patch-phaser-box2d.mjs",
    "build:app": "ST_APP=game vite build && node scripts/app-web.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.2.1",
    "@capacitor-community/in-app-review": "8.0.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/native-purchases": "8.9.6",
    "@dimforge/rapier2d-deterministic-compat": "^0.21.0",
    "@shape-tower/game-services": "file:plugins/game-services",
    "phaser": "^4.2.1",
    "phaser-box2d": "1.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "type": "module",
  "private": true
}
