{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@art/*": [
        "../art/src/*"
      ],
      "@audio": [
        "../audio/src/index.ts"
      ],
      "@audio/*": [
        "../audio/src/*"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}
