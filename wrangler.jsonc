// The Daily ladder's server on Cloudflare (code in online/cloudflare, rules in gameplay.md §12.3).
// Cloudflare builds and deploys it from this repo on every push to main: npm ci here, then wrangler deploy.
// One Durable Object ("ladder") holds everything in its own SQLite database.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shape-tower",
  "main": "online/cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  // The game calls https://shape-tower.<account>.workers.dev/api/v1 (game/src/online/online.ts), so keep it on.
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "LADDER", "class_name": "Ladder" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ladder"] }],
  "observability": { "enabled": true },
  // Pushes to other branches run Cloudflare's Preview build (wrangler preview), which needs this block.
  // Each Preview gets its own empty Durable Object, so a branch never touches the live ladder.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "LADDER", "class_name": "Ladder" }]
    },
    "observability": { "enabled": true }
  }
}
